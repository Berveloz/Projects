<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="loja.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1494"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="vendas" custom_title="0" dock_id="3" table="4,6:mainvendas"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="vendas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="127"/><column index="3" value="79"/><column index="4" value="175"/><column index="5" value="95"/><column index="6" value="83"/><column index="8" value="73"/><column index="9" value="87"/><column index="10" value="124"/><column index="11" value="111"/><column index="12" value="71"/><column index="13" value="175"/><column index="14" value="95"/><column index="15" value="56"/><column index="16" value="56"/><column index="17" value="71"/><column index="18" value="87"/><column index="19" value="79"/><column index="20" value="119"/><column index="21" value="79"/><column index="22" value="63"/><column index="23" value="95"/><column index="24" value="56"/><column index="25" value="56"/><column index="26" value="63"/><column index="27" value="87"/><column index="28" value="56"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Desafios/ Investigativos">-- Desafio 1
SELECT 
	cliente, produto, cidade 
FROM vendas;

-- Desafio 2
SELECT *  
FROM vendas
WHERE cidade = 'Santos'; 

-- Desafio 3
SELECT produto, preco_unitario
FROM vendas
WHERE preco_unitario &gt; 2000

-- Desafio 4
SELECT * FROM vendas
WHERE cidade = 'Campinas' 
AND forma_pagamento = 'Cartão'

-- Desafio 5
SELECT *
FROM vendas
WHERE cidade = 'São Paulo'
	OR cidade = 'Santos'

-- Desafio 6
SELECT produto, preco_unitario
FROM vendas
WHERE preco_unitario BETWEEN 500 AND 1500

-- Desafio 7
SELECT *
FROM vendas
WHERE cliente LIKE 'M%'

-- Desafio 8
SELECT DISTINCT cidade
FROM vendas

-- Desafio 9
SELECT produto, preco_unitario
FROM vendas
ORDER BY  preco_unitario ASC

-- Desafio 10
SELECT produto, preco_unitario
FROM vendas
ORDER BY preco_unitario DESC
LIMIT 3

-- Desafio 11
SELECT 
	cliente,
	produto,
	quantidade,
	preco_unitario,
	quantidade * preco_unitario AS valor_total
FROM vendas

-- Desafio 12
SELECT
	SUM(quantidade * preco_unitario) AS faturamento_total
FROM vendas

-- Desafio 13
SELECT 
	vendedor,
	SUM(quantidade * preco_unitario) AS faturamento
FROM vendas
GROUP BY vendedor

-- Desafio 14
SELECT 
	cidade,
	COUNT(cidade) AS quantidade_vendas
FROM vendas
GROUP BY cidade

-- Desafio 15
SELECT 
	produto,
	AVG(preco_unitario) AS preco_medio
FROM vendas
GROUP BY produto

-- Desafio 16
SELECT 
	vendedor,
	SUM(quantidade * preco_unitario) AS faturamento
FROM vendas
GROUP BY vendedor
HAVING faturamento &gt; 10000

-- Investigativo 1
SELECT 
	cidade,
	SUM(quantidade * preco_unitario) AS faturamento
FROM vendas
GROUP BY cidade
ORDER BY faturamento DESC
-- São Paulo tem o maior faturamento sendo de 16.995,00

-- Investigativo 2
SELECT
	vendedor,
	SUM(quantidade * preco_unitario) AS faturamento
FROM vendas
GROUP BY vendedor
ORDER BY faturamento DESC
-- Fernanda teve o maior faturamento sendo de 17.430,00

-- Investigativo 3
SELECT
	categoria,
	SUM(quantidade * preco_unitario) AS faturamento
FROM vendas
GROUP BY categoria
ORDER BY faturamento DESC
-- A categoria com maior faturamento foi Imformatica com 34.755,00

-- Investigativo 3
SELECT
    cliente,
    SUM(quantidade * preco_unitario) AS ticket_medio
FROM vendas
GROUP BY cliente
ORDER BY ticket_medio DESC

-- Investigativo 4 
SELECT
	forma_pagamento,
	COUNT( forma_pagamento) AS valores
FROM vendas
GROUP BY forma_pagamento
ORDER BY valores DESC
-- A principal forma de pagamento foi PIX

-- Investigativo 5
SELECT
	cliente,
	SUM(quantidade * preco_unitario) AS gastos
FROM vendas
GROUP BY cliente
ORDER BY gastos DESC
LIMIT 5 
-- Os que mais gastaram em ordem decrescente foi Paulo(7600), Yasmin(4500), Karen(4200), Ana(3500), Daniel(2400)

-- Investigativo 6
SELECT
    cidade,
    COUNT(*) AS total_vendas
FROM vendas
GROUP BY cidade
ORDER BY total_vendas DESC
-- São Paulo tem o total de 11 vendas

-- Investigativo 7
SELECT
    vendedor,
    COUNT(*) AS venda
FROM vendas
GROUP BY vendedor
ORDER BY venda DESC
-- Carlos vendeu o total de 11

-- Investigativo 8
SELECT
    produto,
    COUNT(*) AS total_vendas
FROM vendas
GROUP BY produto
ORDER BY total_vendas DESC
-- O Notebook vendeu o total de 4 vezes</sql><current_tab id="0"/></tab_sql></sqlb_project>
